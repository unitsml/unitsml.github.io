---
import { getCollection, render } from 'astro:content';
import ContentLayout from '@layouts/ContentLayout.astro';
import HistoryTimeline from '@components/islands/HistoryTimeline.vue';

const pages = await getCollection('pages');
const page = pages.find(p => p.slug === 'history') || pages.find(p => p.id === 'history');
if (!page) throw new Error('History page not found');
const { Content } = await render(page);

const sidebarItems = [
  { text: 'About UnitsML', link: '/about' },
  { text: 'History', link: '/history' },
  { text: 'Supporters', link: '/supporters' },
  { text: 'Privacy Policy', link: '/privacy' },
  { text: 'Terms of Service', link: '/tos' },
];
---

<ContentLayout title={page.data.title} description={page.data.description} sidebarTitle="About" sidebarItems={sidebarItems}>
  <article class="content-page">
    <Content components={{ HistoryTimeline }} />
  </article>
</ContentLayout>

<style>
  .content-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
